# Q10: Floor Security & Equipment Analysis (O1)
# Benchmark: Access control pattern analysis via floor traversal
# Parameters: $FLOOR_ID - floor to analyze
# Pattern: Floor -> CONTAINS -> Space -> CONTAINS -> Equipment

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?floor_id ?floor_name ?building_id
       ?space_id ?space_name
       ?equipment_id ?equipment_name ?equipment_type
WHERE {
    # Start from specified floor
    ?floor rdf:type btb:Floor ;
           btb:id "$FLOOR_ID" ;
           btb:id ?floor_id ;
           btb:name ?floor_name ;
           btb:building_id ?building_id .

    # Floor contains spaces
    ?floor btb:contains ?space .
    ?space rdf:type btb:Space ;
           btb:id ?space_id ;
           btb:name ?space_name .

    # Optional: Space contains equipment
    OPTIONAL {
        ?space btb:contains ?equipment .
        ?equipment rdf:type btb:Equipment ;
                   btb:id ?equipment_id ;
                   btb:name ?equipment_name ;
                   btb:equipment_type ?equipment_type .
    }
}
ORDER BY ?space_name ?equipment_name
