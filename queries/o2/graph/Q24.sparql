# Q24: Maintenance History
# Équivalent O2 - Agrégation des événements de maintenance
# Paramètres: ?equipmentId

PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?equipmentId ?name
       (COUNT(?event) AS ?event_count)
       (MAX(?eventDate) AS ?last_event_date)
       (SAMPLE(?technician) AS ?last_technician)
       (SUM(?cost) AS ?total_maintenance_cost)
WHERE {
    ?eq btb:id ?equipmentId .
    ?eq btb:name ?name .
    OPTIONAL {
        ?eq btb:hasMaintenanceEvent ?event .
        ?event btb:date ?eventDate .
        OPTIONAL { ?event btb:technician ?technician }
        OPTIONAL { ?event btb:costEur ?cost }
    }
}
GROUP BY ?equipmentId ?name
