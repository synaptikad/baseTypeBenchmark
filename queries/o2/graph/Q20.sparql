# Q20: Shortest HVAC Path
# Status: DEGRADED pour O2 (pas de shortestPath natif)
# Note: Retourne UN chemin, pas garanti le plus court
PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?path_index ?node_id ?node_type ?node_name
WHERE {
    VALUES ?start_id { "ahu_1" }
    VALUES ?end_id { "space_1_1" }

    # Chemin de longueur 1
    {
        ?start btb:id ?start_id ; btb:feeds|btb:serves ?end .
        ?end btb:id ?end_id .
        VALUES (?path_index ?node_id) { (0 ?start_id) (1 ?end_id) }
    }
    UNION
    # Chemin de longueur 2
    {
        ?start btb:id ?start_id ; btb:feeds|btb:serves ?mid .
        ?mid btb:feeds|btb:serves ?end .
        ?end btb:id ?end_id .
        VALUES (?path_index ?node_id) { (0 ?start_id) (1 ?mid) (2 ?end_id) }
        FILTER NOT EXISTS { ?start btb:feeds|btb:serves ?end }
    }

    # Recuperer les infos du noeud
    ?node btb:id ?node_id ;
          btb:name ?node_name .
    OPTIONAL { ?node a btb:Equipment . BIND("Equipment" AS ?node_type) }
    OPTIONAL { ?node a btb:Space . BIND("Space" AS ?node_type) }
}
ORDER BY ?path_index
