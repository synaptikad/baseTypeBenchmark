# Q20: Shortest HVAC Path
# Status: DEGRADED pour O2 (pas de shortestPath natif)
# Note: Retourne UN chemin, pas garanti le plus court
# Params: equipmentId (source), spaceId (target)
PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?path_index ?node_id ?node_type ?node_name
WHERE {
    # Chemin de longueur 1
    {
        ?start btb:id ?equipmentId ; btb:feeds|btb:serves ?end .
        ?end btb:id ?spaceId .
        BIND(0 AS ?path_index)
        BIND(?equipmentId AS ?node_id)
    }
    UNION
    {
        ?start btb:id ?equipmentId ; btb:feeds|btb:serves ?end .
        ?end btb:id ?spaceId .
        BIND(1 AS ?path_index)
        BIND(?spaceId AS ?node_id)
    }
    UNION
    # Chemin de longueur 2
    {
        ?start btb:id ?equipmentId ; btb:feeds|btb:serves ?mid .
        ?mid btb:feeds|btb:serves ?end .
        ?end btb:id ?spaceId .
        ?mid btb:id ?midId .
        FILTER NOT EXISTS { ?start btb:feeds|btb:serves ?end }
        BIND(0 AS ?path_index)
        BIND(?equipmentId AS ?node_id)
    }
    UNION
    {
        ?start btb:id ?equipmentId ; btb:feeds|btb:serves ?mid .
        ?mid btb:feeds|btb:serves ?end .
        ?end btb:id ?spaceId .
        ?mid btb:id ?midId .
        FILTER NOT EXISTS { ?start btb:feeds|btb:serves ?end }
        BIND(1 AS ?path_index)
        BIND(?midId AS ?node_id)
    }
    UNION
    {
        ?start btb:id ?equipmentId ; btb:feeds|btb:serves ?mid .
        ?mid btb:feeds|btb:serves ?end .
        ?end btb:id ?spaceId .
        ?mid btb:id ?midId .
        FILTER NOT EXISTS { ?start btb:feeds|btb:serves ?end }
        BIND(2 AS ?path_index)
        BIND(?spaceId AS ?node_id)
    }

    # Recuperer les infos du noeud
    ?node btb:id ?node_id ;
          btb:name ?node_name .
    OPTIONAL { ?node a btb:Equipment . BIND("Equipment" AS ?node_type) }
    OPTIONAL { ?node a btb:Space . BIND("Space" AS ?node_type) }
}
ORDER BY ?path_index
