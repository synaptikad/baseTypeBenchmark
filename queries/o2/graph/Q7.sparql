# Q7: Drift Top-20 - Extraction point_ids
# Navigate via Building -> Floor -> Space -> Equipment -> Point
PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?point_id
WHERE {
    ?building a btb:Building ;
              btb:id ?buildingId .
    ?building btb:contains ?floor .
    ?floor btb:contains ?space .
    ?eq btb:serves|btb:locatedIn|btb:monitors ?space .
    ?eq btb:hasPoint ?point .
    ?point btb:id ?point_id .
}
