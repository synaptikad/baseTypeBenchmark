# Q15: Warranty Expiry
# Status: DEGRADED pour O2
# Note: warranty_end doit être un triple dédié
PREFIX btb: <http://basetype.benchmark/ontology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?equipment_id ?name ?equipment_type ?warranty_end
       (xsd:integer(?warranty_end - ?referenceDate) AS ?days_remaining)
WHERE {
    ?eq a btb:Equipment ;
        btb:id ?equipment_id ;
        btb:name ?name ;
        btb:equipmentType ?equipment_type ;
        btb:metadataWarrantyEnd ?warranty_end .

    FILTER(?warranty_end >= ?referenceDate)
    FILTER(?warranty_end <= ?referenceDate + xsd:dayTimeDuration(CONCAT("P", STR(?daysAhead), "D")))
}
ORDER BY ?days_remaining ?equipment_id
