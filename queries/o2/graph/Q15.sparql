# Q15: Warranty Expiry
# Status: DEGRADED pour O2
# Note: warranty_end doit être un triple dédié
PREFIX btb: <http://basetype.benchmark/ontology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?equipment_id ?name ?equipment_type ?warranty_end
       (xsd:integer(?warranty_end - ?ref_date) AS ?days_remaining)
WHERE {
    VALUES ?ref_date { "2024-06-01"^^xsd:date }
    VALUES ?days_ahead { 90 }

    ?eq a btb:Equipment ;
        btb:id ?equipment_id ;
        btb:name ?name ;
        btb:equipmentType ?equipment_type ;
        btb:warrantyEnd ?warranty_end .

    FILTER(?warranty_end >= ?ref_date)
    FILTER(?warranty_end <= ?ref_date + xsd:dayTimeDuration(CONCAT("P", STR(?days_ahead), "D")))
}
ORDER BY ?days_remaining ?equipment_id
