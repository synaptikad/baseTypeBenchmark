# Q23: Failure Impact Analysis
# Status: DEGRADED pour O2 (property path avec limite fixe)
# Semantic: If this equipment fails, which spaces/equipment are impacted within N hops?
# Paramètres: equipmentId, maxHops (ignoré, fixé à 3)
PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT DISTINCT ?node_id ?node_type ?node_name (MIN(?dist) AS ?hop_distance)
WHERE {
    ?start a btb:Equipment ;
           btb:id ?equipmentId .

    # Relations de propagation pour analyse d'impact de panne
    # FEEDS: flux d'énergie/fluide (bidirectionnel pour impact)
    # SERVES: dépendance de service
    # POWERS: dépendance électrique

    {
        # Hop 1: voisins directs
        {
            ?start btb:feeds ?node .
        } UNION {
            ?node btb:feeds ?start .
        } UNION {
            ?start btb:serves ?node .
        } UNION {
            ?node btb:serves ?start .
        } UNION {
            ?start btb:powers ?node .
        } UNION {
            ?node btb:powers ?start .
        }
        BIND(1 AS ?dist)
    }
    UNION
    {
        # Hop 2
        {
            ?start btb:feeds|btb:serves|btb:powers ?mid1 .
        } UNION {
            ?mid1 btb:feeds|btb:serves|btb:powers ?start .
        }

        {
            ?mid1 btb:feeds|btb:serves|btb:powers ?node .
        } UNION {
            ?node btb:feeds|btb:serves|btb:powers ?mid1 .
        }
        FILTER(?node != ?start)
        BIND(2 AS ?dist)
    }
    UNION
    {
        # Hop 3
        {
            ?start btb:feeds|btb:serves|btb:powers ?mid1 .
        } UNION {
            ?mid1 btb:feeds|btb:serves|btb:powers ?start .
        }

        {
            ?mid1 btb:feeds|btb:serves|btb:powers ?mid2 .
        } UNION {
            ?mid2 btb:feeds|btb:serves|btb:powers ?mid1 .
        }
        FILTER(?mid2 != ?start)

        {
            ?mid2 btb:feeds|btb:serves|btb:powers ?node .
        } UNION {
            ?node btb:feeds|btb:serves|btb:powers ?mid2 .
        }
        FILTER(?node != ?start && ?node != ?mid1)
        BIND(3 AS ?dist)
    }

    ?node btb:id ?node_id ;
          btb:name ?node_name .

    # Déterminer le type
    OPTIONAL { ?node a btb:Space . BIND("Space" AS ?t1) }
    OPTIONAL { ?node a btb:Equipment . BIND("Equipment" AS ?t2) }
    BIND(COALESCE(?t1, ?t2, "Unknown") AS ?node_type)
}
GROUP BY ?node_id ?node_type ?node_name
ORDER BY ?hop_distance ?node_type ?node_id
