# Q25: Equipment Audit Trail
# Équivalent O2 - Vue 360° équipement
# Paramètres: ?equipmentId

PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?equipmentId ?name ?equipmentType
       ?currentFirmware ?lastFirmwareUpdate
       (COUNT(DISTINCT ?event) AS ?maintenance_events)
       (MAX(?eventDate) AS ?last_maintenance_date)
       ?healthStatus
WHERE {
    ?eq btb:id ?equipmentId .
    ?eq btb:name ?name .
    OPTIONAL { ?eq btb:equipmentType ?equipmentType }
    OPTIONAL { ?eq btb:firmwareVersion ?currentFirmware }
    OPTIONAL { ?eq btb:firmwareUpdateDate ?lastFirmwareUpdate }
    OPTIONAL {
        ?eq btb:hasMaintenanceEvent ?event .
        ?event btb:date ?eventDate .
    }
    OPTIONAL { ?eq btb:maintenancePriority ?priority }
    BIND(
        IF(?priority = "critical", "CRITICAL",
           IF(COUNT(?event) > 5, "HIGH_MAINTENANCE", "NORMAL"))
        AS ?healthStatus
    )
}
GROUP BY ?equipmentId ?name ?equipmentType ?currentFirmware ?lastFirmwareUpdate ?healthStatus
