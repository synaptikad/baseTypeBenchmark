# Q26: Capability Evolution
# Équivalent O2 - Distribution capabilities par type
# Paramètres: ?domain

PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?equipmentType
       (COUNT(DISTINCT ?eq) AS ?equipment_count)
       (GROUP_CONCAT(DISTINCT ?cap; separator=", ") AS ?capabilities)
       (SAMPLE(?cap) AS ?most_common_capability)
WHERE {
    ?eq a btb:Equipment .
    ?eq btb:domain ?domain .
    ?eq btb:equipmentType ?equipmentType .
    OPTIONAL { ?eq btb:hasCapability ?cap }
}
GROUP BY ?equipmentType
ORDER BY DESC(?equipment_count)
