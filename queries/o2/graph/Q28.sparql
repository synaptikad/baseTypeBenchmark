# Q28: Tenant Impact Chain
# Status: DEGRADED pour O2 (property path avec limite fixe)
# Semantic: If this submeter is cut, which tenants are impacted?
# Parametres: ?meterId

PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?tenant_id ?tenant_name
       (COUNT(DISTINCT ?space) AS ?affected_spaces)
       (COUNT(DISTINCT ?eq) AS ?affected_equipment)
WHERE {
    # Start from the meter (SubMeter or MainMeter)
    ?meter btb:id ?meterId ;
           btb:equipmentType ?meterType .
    FILTER(?meterType IN ("SubMeter", "MainMeter"))

    # Follow FEEDS chain (1-3 hops) to equipment
    {
        # Hop 1
        ?meter btb:feeds ?eq .
    } UNION {
        # Hop 2
        ?meter btb:feeds ?mid1 .
        ?mid1 btb:feeds ?eq .
    } UNION {
        # Hop 3
        ?meter btb:feeds ?mid1 .
        ?mid1 btb:feeds ?mid2 .
        ?mid2 btb:feeds ?eq .
    }

    # Equipment serves space
    ?eq btb:serves ?space .
    ?space a btb:Space .

    # Tenant occupies space
    ?tenant btb:occupies ?space ;
            a btb:Tenant ;
            btb:id ?tenant_id ;
            btb:name ?tenant_name .
}
GROUP BY ?tenant_id ?tenant_name
ORDER BY DESC(?affected_equipment) ?tenant_id
