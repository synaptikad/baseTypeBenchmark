# Q19: Equipment Digital Twin
# Status: DEGRADED pour O2
# Note: SPARQL ne construit pas facilement des documents JSON imbriqués
PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?id ?name ?type ?domain
       (GROUP_CONCAT(DISTINCT ?cap; separator=",") AS ?capabilities)
       (GROUP_CONCAT(DISTINCT ?tag; separator=",") AS ?tags)
       (GROUP_CONCAT(DISTINCT ?point_info; separator="|") AS ?points)
WHERE {
    VALUES ?equipment_id { "ahu_1" }

    ?eq btb:id ?equipment_id ;
        btb:id ?id ;
        btb:name ?name ;
        btb:equipmentType ?type ;
        btb:domain ?domain .

    OPTIONAL { ?eq btb:capability ?cap }
    OPTIONAL { ?eq btb:tag ?tag }
    OPTIONAL {
        ?eq btb:hasPoint ?point .
        ?point btb:id ?pid ;
               btb:name ?pname ;
               btb:quantity ?pqty .
        BIND(CONCAT(?pid, ":", ?pname, ":", ?pqty) AS ?point_info)
    }
}
GROUP BY ?id ?name ?type ?domain

# Note: Le résultat doit être post-traité pour construire le JSON
