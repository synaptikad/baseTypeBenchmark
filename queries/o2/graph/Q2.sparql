# Q2: Functional Impact (upstream multi-relations)
# Parametre: equipmentId - ID de l'equipement source
PREFIX btb: <http://basetype.benchmark/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?id ?type ?name ?relType
WHERE {
    ?source btb:id ?equipmentId .

    # Traversee inverse (upstream)
    # Note: SPARQL property paths ne supportent pas l'alternative avec ^
    # On utilise UNION

    {
        ?parent btb:feeds+ ?source .
        BIND("FEEDS" AS ?relType)
    }
    UNION
    {
        ?parent btb:serves ?source .
        BIND("SERVES" AS ?relType)
    }
    UNION
    {
        ?parent btb:contains+ ?source .
        BIND("CONTAINS" AS ?relType)
    }

    ?parent btb:id ?id ;
            btb:name ?name .

    # Type du parent
    ?parent rdf:type ?typeUri .
    BIND(STRAFTER(STR(?typeUri), "#") AS ?type)
}
ORDER BY ?id
