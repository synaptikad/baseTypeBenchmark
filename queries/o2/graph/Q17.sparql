# Q17: Capability Filter
# Status: DEGRADED pour O2
PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?equipment_id ?name ?equipment_type
       (GROUP_CONCAT(?cap; separator=",") AS ?all_capabilities)
WHERE {
    ?eq a btb:Equipment ;
        btb:id ?equipment_id ;
        btb:name ?name ;
        btb:equipmentType ?equipment_type ;
        btb:domain "HVAC" ;
        btb:capability ?cap .

    FILTER EXISTS { ?eq btb:capability "humidity_control" }
}
GROUP BY ?equipment_id ?name ?equipment_type
ORDER BY ?equipment_type ?equipment_id
