# Q18: Calibration Chain
# Status: DEGRADED pour O2
PREFIX btb: <http://basetype.benchmark/ontology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?point_id ?point_name ?equipment_id ?last_calibration ?next_calibration
WHERE {
    ?meter btb:id ?meterId .
    ?meter btb:feeds+ ?eq .
    ?eq btb:hasPoint ?point .

    ?point btb:id ?point_id ;
           btb:name ?point_name ;
           btb:calibrationNextDate ?next_calibration .

    ?eq btb:id ?equipment_id .

    OPTIONAL { ?point btb:calibrationLastDate ?last_calibration }

    FILTER(?next_calibration < ?referenceDate)
}
ORDER BY DESC(?referenceDate - ?next_calibration) ?point_id
