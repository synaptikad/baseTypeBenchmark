# Q13: Office Hours Comfort - Points bureaux
PREFIX btb: <http://basetype.benchmark/ontology#>

SELECT ?space_id ?space_name ?point_id ?quantity
WHERE {
    ?space a btb:Space ;
           btb:id ?space_id ;
           btb:name ?space_name ;
           btb:buildingId "building_1" ;
           btb:spaceType ?spaceType .
    FILTER(STRSTARTS(?spaceType, "office"))

    ?eq btb:serves|btb:monitors|btb:locatedIn ?space ;
        btb:hasPoint ?point .
    ?point btb:id ?point_id ;
           btb:quantity ?quantity .
    FILTER(?quantity IN ("temperature", "co2"))
}
