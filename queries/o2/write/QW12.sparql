# QW12: Tenant Merge
# Status: DEGRADED pour O2 (multiple DELETE + INSERT)
# Semantic: Transfère toutes les relations OCCUPIES et METERS_TENANT du source vers target
# Paramètres: ?sourceTenantId, ?targetTenantId

PREFIX btb: <http://basetype.benchmark/ontology#>

# Transfer OCCUPIES relations
DELETE {
    ?sourceTenant btb:occupies ?space .
}
INSERT {
    ?targetTenant btb:occupies ?space .
}
WHERE {
    ?sourceTenant btb:id ?sourceTenantId ;
                  a btb:Tenant ;
                  btb:occupies ?space .
    ?targetTenant btb:id ?targetTenantId ;
                  a btb:Tenant .
}
;
# Transfer METERS_TENANT relations
DELETE {
    ?meter btb:metersTenant ?sourceTenant .
}
INSERT {
    ?meter btb:metersTenant ?targetTenant .
}
WHERE {
    ?sourceTenant btb:id ?sourceTenantId ;
                  a btb:Tenant .
    ?targetTenant btb:id ?targetTenantId ;
                  a btb:Tenant .
    ?meter btb:metersTenant ?sourceTenant .
}
