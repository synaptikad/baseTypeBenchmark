# QW2: Metadata Update
# Status: DEGRADED pour O2 (DELETE/INSERT pattern)
# Semantic: Met à jour un tag sur un nœud
# Paramètres: ?nodeId, ?tagKey (ignored - uses calibration_status), ?tagValue

PREFIX btb: <http://basetype.benchmark/ontology#>

DELETE {
    ?node btb:calibration_status ?oldValue .
}
INSERT {
    ?node btb:calibration_status ?tagValue .
}
WHERE {
    ?node btb:id ?nodeId .
    OPTIONAL { ?node btb:calibration_status ?oldValue }
}
