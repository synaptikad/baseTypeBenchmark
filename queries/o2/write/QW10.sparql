# QW10: Tenant Move-Out
# Status: DEGRADED pour O2 (DELETE DATA)
# Semantic: Supprime TOUTES les relations OCCUPIES et METERS_TENANT pour un tenant
# Paramètres: ?tenantId
# Note: occupies = tenant->space, metersTenant = meter->tenant

PREFIX btb: <http://basetype.benchmark/ontology#>

DELETE {
    ?tenant btb:occupies ?space .
    ?meter btb:metersTenant ?tenant .
}
WHERE {
    ?tenant btb:id ?tenantId ;
            a btb:Tenant .
    OPTIONAL { ?tenant btb:occupies ?space . }
    OPTIONAL { ?meter btb:metersTenant ?tenant . }
}
