# QW10: Tenant Move-Out
# Status: DEGRADED pour O2 (DELETE DATA)
# Semantic: Supprime relation OCCUPIES entre tenant et space
# Paramètres: ?tenantId, ?spaceId

PREFIX btb: <http://basetype.benchmark/ontology#>

DELETE {
    ?tenant btb:occupies ?space .
}
WHERE {
    ?tenant btb:id ?tenantId ;
            a btb:Tenant ;
            btb:occupies ?space .
    ?space btb:id ?spaceId ;
           a btb:Space .
}
