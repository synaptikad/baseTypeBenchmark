# QW11: Space Reassignment
# Status: DEGRADED pour O2 (DELETE + INSERT non atomique)
# Semantic: Réaffecte un espace de oldTenant vers newTenant
# Paramètres: ?spaceId, ?oldTenantId, ?newTenantId

PREFIX btb: <http://basetype.benchmark/ontology#>

DELETE {
    ?oldTenant btb:occupies ?space .
}
INSERT {
    ?newTenant btb:occupies ?space .
}
WHERE {
    ?space btb:id ?spaceId ;
           a btb:Space .
    ?oldTenant btb:id ?oldTenantId ;
               a btb:Tenant .
    ?newTenant btb:id ?newTenantId ;
               a btb:Tenant .
    OPTIONAL { ?oldTenant btb:occupies ?space }
}
