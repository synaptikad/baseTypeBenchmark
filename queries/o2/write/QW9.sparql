# QW9: Tenant Move-In
# Status: DEGRADED pour O2 (INSERT DATA triples)
# Semantic: Crée relation OCCUPIES entre tenant et space, optionnel METERS_TENANT
# Paramètres: ?tenantId, ?spaceId, ?meterId (optional)

PREFIX btb: <http://basetype.benchmark/ontology#>

INSERT {
    ?tenant btb:occupies ?space .
}
WHERE {
    ?tenant btb:id ?tenantId ;
            a btb:Tenant .
    ?space btb:id ?spaceId ;
           a btb:Space .
}
